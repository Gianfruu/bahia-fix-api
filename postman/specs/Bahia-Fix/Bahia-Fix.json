{
  "openapi": "3.0.0",
  "info": {
    "title": "Bahia-Fix",
    "version": "1.0.0",
    "description": "Colección grupal de la API de Bahía Fix, organizada por integrante y módulos según las ramas de trabajo del repositorio. Variable requerida: base_url. Valor local: http://localhost:3000/api/v1. La API utiliza datos simulados en memoria."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "paths": {
    "/clientes": {
      "get": {
        "summary": "Listar clientes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": ""
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "id"
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "asc"
          }
        ],
        "responses": {},
        "tags": [
          "Ignacio Painenahuel Luna - Clientes y Equipos"
        ],
        "description": "Listado con paginación y búsqueda. La ruta utiliza page, limit y q; sortBy/order no están aplicados en esta ruta actualmente."
      },
      "post": {
        "summary": "Crear cliente",
        "responses": {},
        "tags": [
          "Ignacio Painenahuel Luna - Clientes y Equipos"
        ],
        "description": "Crea un cliente. Requiere nombre, apellido, teléfono, email válido y localidad.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "apellido": {
                    "type": "string"
                  },
                  "telefono": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "localidad": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "nombre": "Juan",
                "apellido": "Pérez",
                "telefono": "291 400-0000",
                "email": "juan.perez@example.com",
                "localidad": "Bahía Blanca"
              }
            }
          }
        }
      }
    },
